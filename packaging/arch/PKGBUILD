# couriercollie for Arch Linux (the AUR). Built and tested by devtools/build_package.sh arch, in a container.
# Before publishing to the AUR: a public release tag to download, and its real sha256sum.
pkgname=couriercollie
pkgver=0.6.2
pkgrel=1
pkgdesc="Keep track of software from GitHub and GitLab, and update it"
arch=('any')
url="https://github.com/FalloutSeeker/couriercollie"
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later')  # the app; the Breeze icons it brings along
depends=('python' 'pyside6' 'kirigami' 'libnotify' 'git' 'polkit' 'libsecret' 'hicolor-icon-theme')
optdepends=('qqc2-desktop-style: KDE look for the window (without it, Qt Fusion)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$pkgname-$pkgver"
    local site
    site=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
    install -d "$pkgdir$site"
    cp -a couriercollie "$pkgdir$site/"
    find "$pkgdir$site/couriercollie" -name __pycache__ -prune -exec rm -rf {} +
    python -m compileall -q -d "$site/couriercollie" "$pkgdir$site/couriercollie"
    install -Dm755 data/couriercollie "$pkgdir/usr/bin/couriercollie"
    install -Dm644 data/couriercollie.desktop "$pkgdir/usr/share/applications/couriercollie.desktop"
    install -d "$pkgdir/usr/share/icons"
    cp -a data/icons/hicolor "$pkgdir/usr/share/icons/"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
